rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isOptionalString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    function isOptionalTimestamp(value) {
      return value == null || value is timestamp;
    }

    match /comments/{commentId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 1000;

      allow create: if isSignedIn()
        && commentId.matches("^" + request.auth.uid + "_[0-9]{13}_[a-z0-9]{8}$")
        && request.resource.data.keys().hasOnly([
          "repoId",
          "text",
          "userId",
          "displayName",
          "photoURL",
          "createdAt",
          "clientRequestId"
        ])
        && isNonEmptyString(request.resource.data.repoId, 120)
        && isNonEmptyString(request.resource.data.text, 2000)
        && request.resource.data.userId == request.auth.uid
        && isNonEmptyString(request.resource.data.displayName, 120)
        && isOptionalString(request.resource.data.photoURL, 500)
        && isOptionalString(request.resource.data.clientRequestId, 120)
        && request.resource.data.createdAt == request.time;

      allow delete: if false;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "text",
          "deleted",
          "deletedAt"
        ])
        && request.resource.data.text == ""
        && request.resource.data.deleted == true
        && resource.data.deleted != true
        && request.resource.data.deletedAt == request.time;

      match /replies/{replyId} {
        allow get: if true;
        allow list: if request.query.limit != null && request.query.limit <= 100;

        allow create: if isSignedIn()
          && replyId.matches("^" + request.auth.uid + "_[0-9]{13}_[a-z0-9]{8}$")
          && exists(/databases/$(database)/documents/comments/$(commentId))
          && get(/databases/$(database)/documents/comments/$(commentId)).data.deleted != true
          && request.resource.data.keys().hasOnly([
            "userId",
            "displayName",
            "photoURL",
            "text",
            "createdAt",
            "clientRequestId"
          ])
          && request.resource.data.userId == request.auth.uid
          && isNonEmptyString(request.resource.data.displayName, 120)
          && isOptionalString(request.resource.data.photoURL, 500)
          && isNonEmptyString(request.resource.data.text, 1000)
          && isOptionalString(request.resource.data.clientRequestId, 120)
          && request.resource.data.createdAt == request.time;

        allow delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;

        allow update: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && reportId == request.resource.data.commentId + "_" + request.auth.uid
        && exists(/databases/$(database)/documents/comments/$(request.resource.data.commentId))
        && get(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data.userId == request.resource.data.commentUserId
        && request.resource.data.keys().hasOnly([
          "repoId",
          "commentId",
          "commentUserId",
          "reporterUserId",
          "createdAt"
        ])
        && isNonEmptyString(request.resource.data.repoId, 120)
        && isNonEmptyString(request.resource.data.commentId, 160)
        && isNonEmptyString(request.resource.data.commentUserId, 160)
        && request.resource.data.commentUserId != request.auth.uid
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
