rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isOptionalString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          "repoId",
          "text",
          "userId",
          "displayName",
          "photoURL",
          "createdAt",
          "replyCount",
          "clientRequestId"
        ])
        && isNonEmptyString(request.resource.data.repoId, 120)
        && isNonEmptyString(request.resource.data.text, 2000)
        && request.resource.data.userId == request.auth.uid
        && isNonEmptyString(request.resource.data.displayName, 120)
        && isOptionalString(request.resource.data.photoURL, 500)
        && isOptionalString(request.resource.data.clientRequestId, 120)
        && request.resource.data.replyCount is int
        && request.resource.data.replyCount == 0;

      // [보안 수정] 댓글 소유자만 삭제 가능 (기존과 동일, 명시적 유지)
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["replyCount"])
        && request.resource.data.replyCount is int
        && request.resource.data.replyCount >= 0;

      match /replies/{replyId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
            "userId",
            "displayName",
            "photoURL",
            "text",
            "createdAt",
            "clientRequestId"
          ])
          && request.resource.data.userId == request.auth.uid
          && isNonEmptyString(request.resource.data.displayName, 120)
          && isOptionalString(request.resource.data.photoURL, 500)
          && isNonEmptyString(request.resource.data.text, 1000)
          && isOptionalString(request.resource.data.clientRequestId, 120);

        // [보안 수정] 대댓글 삭제는 대댓글 작성자 본인만 가능
        // 기존: 댓글 소유자가 타인의 대댓글도 삭제 가능했던 UI 버그와 분리
        // 서버 규칙에서 reply.userId == 요청자 uid 만 허용
        allow delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;

        allow update: if false;
      }
    }

    // [보안 유지] 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
